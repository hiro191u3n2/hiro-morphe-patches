#version 310 es
#extension GL_EXT_gpu_shader5 : require
/* GX1/GX2/GX4/GX7: NR9--NR13 unchanged single-image computation.
 * No search reduction, precision reduction, synthetic detail or frame merging.
 * GL_EXT_gpu_shader5 precise prevents contraction/reassociation; every device
 * must additionally pass the Java oracle admission before this shader is used.
 * Binding 0: immutable ARGB source band, row u[14] is its first row.
 * Binding 1: packed preparation delta or full ARGB, core rows only.
 * Binding 2: 16 noise bins then interleaved regional Y/C/detail evidence;
 *            regional grid row u[13] is first retained row.
 * Binding 3: optional core-only interleaved budgetQ8/detailQ8.
 * Binding 4/5/6: immutable half/quarter/eighth delta maps, first rows u[15..17].
 * Binding 7: sparse NR13 confidence, ceil(width/4)*ceil(coreRows/4) integers;
 *            allocate/clear before dispatch. One owning invocation per cell.
 * u[0]=width,u[1]=source rows,u[2]=begin,u[3]=end,u[4]=validBegin,
 * u[5]=validEnd,u[6]=originY,u[7]=fullHeight,u[8]=noise,u[9]=shadows,
 * u[10]=mode (0 half prep,1 quarter prep,2 eighth prep,3 full),
 * u[11]=hasPolicy,u[12]=captureConfidence,u[13]=firstGridY,
 * u[14]=sourceFirstY,u[15..17]=mapFirstY. f[] unused.
 * u[31]=global invocation base, owned by engine for large split dispatches.
 * Dispatch 64 x 1 x 1, ceil(width*(end-begin)/64) workgroups.
 */
precision highp float;
precision highp int;
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(std430,binding=0) readonly buffer Source1960 { uint src[]; };
layout(std430,binding=1) writeonly buffer Output1960 { uint dst[]; };
layout(std430,binding=2) readonly buffer Evidence1960 { float evidence[]; };
layout(std430,binding=3) readonly buffer Policy1960 { int policy[]; };
layout(std430,binding=4) readonly buffer Half1960 { uint halfMap[]; };
layout(std430,binding=5) readonly buffer Quarter1960 { uint quarterMap[]; };
layout(std430,binding=6) readonly buffer Eighth1960 { uint eighthMap[]; };
layout(std430,binding=7) writeonly buffer Confidence1960 { int confidenceMap[]; };
uniform int u[32];
uniform float f[32];

int halfSize(int a){return a/2+(a&1);}
int roundFloat(float value){
    int whole=int(value);
    // Exact Java Math.round ties, without rounding value+0.5 prematurely.
    precise float fraction=value-float(whole);
    return whole+(fraction>=0.5?1:fraction< -0.5?-1:0);
}
int byteValue(float value){return clamp(roundFloat(value),0,255);}
float square(float value){precise float result=value*value;return result;}
uint pixel(int x,int y){
    x=clamp(x,0,u[0]-1);y=clamp(y,0,u[1]-1);
    return src[(y-u[14])*u[0]+x];
}
float luma(uint p){
    precise float result=.299*float((p>>16)&255u)+.587*float((p>>8)&255u)+.114*float(p&255u);
    return result;
}
vec3 color(int x,int y){
    uint p=pixel(x,y);precise float yy=luma(p);
    precise float rr=float((p>>16)&255u)-yy,bb=float(p&255u)-yy;
    return vec3(yy,rr,bb);
}
float sigma(int offset,float mean){
    precise float x=clamp((mean-16.0)/32.0,0.0,7.0);
    int a=int(x),b=min(7,a+1);
    precise float result=evidence[offset+a]*(1.0-(x-float(a)))+evidence[offset+b]*(x-float(a));
    return result;
}
float structure(int x,int y,int validBegin,int validEnd){
    precise float left=0.0,right=0.0,up=0.0,down=0.0;
    int n=0;
    for(int k=-1;k<=1;k++){
        int sideY=clamp(y+k,validBegin,validEnd-1),upY=clamp(y-2,validBegin,validEnd-1),downY=clamp(y+2,validBegin,validEnd-1);
        uint a=pixel(x-2,sideY),b=pixel(x+2,sideY),c=pixel(x+k,upY),d=pixel(x+k,downY);
        if((a>>24)!=255u||(b>>24)!=255u||(c>>24)!=255u||(d>>24)!=255u)return 255.0;
        left+=color(x-2,sideY).x;right+=color(x+2,sideY).x;
        up+=color(x+k,upY).x;down+=color(x+k,downY).x;n++;
    }
    precise float result=(abs(right-left)+abs(down-up))/float(n);return result;
}
vec2 guide(int x,int y,int validBegin,int validEnd,float sy,float sc){
    precise float ly=0.0,ry=0.0,uy=0.0,dy=0.0,lr=0.0,rr=0.0,ur=0.0,dr=0.0,lb=0.0,rb=0.0,ub=0.0,db=0.0;
    for(int k=-1;k<=1;k++)for(int d=2;d<=3;d++){
        int sideY=clamp(y+k,validBegin,validEnd-1),upY=clamp(y-d,validBegin,validEnd-1),downY=clamp(y+d,validBegin,validEnd-1);
        uint a=pixel(x-d,sideY),b=pixel(x+d,sideY),c=pixel(x+k,upY),e=pixel(x+k,downY);
        if((a>>24)!=255u||(b>>24)!=255u||(c>>24)!=255u||(e>>24)!=255u)return vec2(0.0);
        precise vec3 ca=color(x-d,sideY),cb=color(x+d,sideY),cc=color(x+k,upY),ce=color(x+k,downY);
        ly+=ca.x;ry+=cb.x;uy+=cc.x;dy+=ce.x;
        lr+=ca.y;rr+=cb.y;ur+=cc.y;dr+=ce.y;
        lb+=ca.z;rb+=cb.z;ub+=cc.z;db+=ce.z;
    }
    precise float centerY=0.0,centerR=0.0,centerB=0.0;
    for(int py=-1;py<=1;py++)for(int px=-1;px<=1;px++){
        int cy=clamp(y+py,validBegin,validEnd-1);uint p=pixel(x+px,cy);
        if((p>>24)!=255u)return vec2(0.0);
        precise vec3 cp=color(x+px,cy);centerY+=cp.x;centerR+=cp.y;centerB+=cp.z;
    }
    precise float curveY=max(abs(ly+ry-centerY*4.0/3.0),abs(uy+dy-centerY*4.0/3.0))/6.0;
    precise float curveC=max(abs(lr+rr-centerR*4.0/3.0)+abs(lb+rb-centerB*4.0/3.0),abs(ur+dr-centerR*4.0/3.0)+abs(ub+db-centerB*4.0/3.0))/6.0;
    precise float edgeY=max(abs(ry-ly),abs(dy-uy))/6.0;
    precise float edgeC=max(abs(rr-lr)+abs(rb-lb),abs(dr-ur)+abs(db-ub))/6.0;
    edgeY=max(0.0,edgeY-sy*.85);edgeC=max(0.0,edgeC-sc*2.0);
    precise float outY=1.0/(1.0+square(edgeY/(sy*1.7+2.0))+square(max(0.0,curveY-sy*1.4)/(sy*.85+1.0)));
    precise float outC=1.0/(1.0+square(edgeC/(sc*1.0+1.5))+square(max(0.0,curveC-sc*2.5)/(sc*1.5+2.0)));
    return vec2(outY,outC);
}
float regionalSigma(int x,int y,int plane){
    int rw=(u[0]+63)/64,rh=(u[7]+63)/64;
    precise float fx=clamp((float(x)+.5)/64.0-.5,0.0,float(rw-1));
    precise float fy=clamp((float(y)+.5)/64.0-.5,0.0,float(rh-1));
    int ix=int(fx),iy=int(fy),nx=min(rw-1,ix+1),ny=min(rh-1,iy+1);
    fx-=float(ix);fy-=float(iy);iy-=u[13];ny-=u[13];
    precise float a=evidence[16+3*(iy*rw+ix)+plane],b=evidence[16+3*(iy*rw+nx)+plane];
    precise float c=evidence[16+3*(ny*rw+ix)+plane],d=evidence[16+3*(ny*rw+nx)+plane];
    precise float result=(a*(1.0-fx)+b*fx)*(1.0-fy)+(c*(1.0-fx)+d*fx)*fy;return result;
}
// Eight original-resolution or half-resolution candidates, five samples each.
vec3 nonlocalFine(int x,int y,int validBegin,int validEnd,float sy,float sc){
    precise vec3 cp=color(x,y);
    precise float total=1.0,sumY=cp.x,sumR=cp.y,sumB=cp.z;
    precise float variance=sy*sy+.22*sc*sc,h2=max(1.5,variance*3.2);
    for(int dy=-4;dy<=4;dy+=4)for(int dx=-4;dx<=4;dx+=4){
        if(dx==0&&dy==0)continue;
        int cx=x+dx,cy=y+dy;
        if(cx<0||cy<validBegin||cx>=u[0]||cy>=validEnd)continue;
        precise float distance=0.0,patchY=0.0,patchR=0.0,patchB=0.0;bool valid=true;
        for(int k=0;k<5;k++){
            int px=k==1?-1:k==2?1:0,py=k==3?-1:k==4?1:0;
            int ay=clamp(y+py,validBegin,validEnd-1),by=clamp(cy+py,validBegin,validEnd-1);
            uint a=pixel(x+px,ay),b=pixel(cx+px,by);
            if((a>>24)!=255u||(b>>24)!=255u){valid=false;continue;}
            precise vec3 ca=color(x+px,ay),cb=color(cx+px,by);
            distance+=square(ca.x-cb.x)+.11*(square(ca.y-cb.y)+square(ca.z-cb.z));
            patchY+=cb.x;patchR+=cb.y;patchB+=cb.z;
        }
        if(!valid)continue;
        distance=max(0.0,distance/5.0-2.0*variance);precise float z=distance/h2;
        if(z>5.0)continue;
        precise float weight=1.0/(1.0+z+z*z*.5+z*z*z/6.0);
        sumY+=weight*(patchY/5.0);sumR+=weight*(patchR/5.0);sumB+=weight*(patchB/5.0);total+=weight;
    }
    precise vec3 result=vec3(sumY/total,sumR/total,sumB/total);return result;
}
// Twenty-four quarter-resolution candidates, nine samples each.
vec3 nonlocalCoarse(int x,int y,float sy,float sc){
    precise vec3 cp=color(x,y);
    precise float total=1.0,sumY=cp.x,sumR=cp.y,sumB=cp.z;
    precise float variance=sy*sy+.22*sc*sc,h2=max(1.5,variance*2.6);
    for(int dy=-6;dy<=6;dy+=3)for(int dx=-6;dx<=6;dx+=3){
        if(dx==0&&dy==0)continue;
        int cx=x+dx,cy=y+dy;
        if(cx<0||cy<0||cx>=u[0]||cy>=u[1])continue;
        if((pixel(cx,cy)>>24)!=255u)continue;
        precise float distance=0.0;bool valid=true;
        for(int py=-1;py<=1;py++)for(int px=-1;px<=1;px++){
            uint a=pixel(x+px,y+py),b=pixel(cx+px,cy+py);
            if((a>>24)!=255u||(b>>24)!=255u){valid=false;continue;}
            precise vec3 ca=color(x+px,y+py),cb=color(cx+px,cy+py);
            distance+=square(ca.x-cb.x)+.11*(square(ca.y-cb.y)+square(ca.z-cb.z));
        }
        if(!valid)continue;
        distance=max(0.0,distance/9.0-2.0*variance);precise float z=distance/h2;
        if(z>5.0)continue;
        precise float weight=1.0/(1.0+z+z*z*.5+z*z*z/6.0);
        precise vec3 cq=color(cx,cy);
        sumY+=weight*cq.x;sumR+=weight*cq.y;sumB+=weight*cq.z;total+=weight;
    }
    precise vec3 result=vec3(sumY/total,sumR/total,sumB/total);return result;
}
uint packDelta(int gray,float r,float g,float b){
    return (uint(clamp(gray,0,255))<<24)|(uint(clamp(roundFloat(r),-127,127)&255)<<16)|
           (uint(clamp(roundFloat(g),-127,127)&255)<<8)|uint(clamp(roundFloat(b),-127,127)&255);
}
void localWork(int x,int y,int validBegin,int validEnd,float thresholdY,float thresholdC,vec3 cp,
               out vec3 sums,out vec3 weights){
    precise float sumY=0.0,sumR=0.0,sumB=0.0,weightY=0.0,weightC=0.0,varY=0.0;
    for(int dy=-2;dy<=2;dy++)for(int dx=-2;dx<=2;dx++){
        int cy=clamp(y+dy,validBegin,validEnd-1);uint q=pixel(x+dx,cy);
        if((q>>24)!=255u)continue;
        precise vec3 cq=color(x+dx,cy);
        precise float base=dx==0&&dy==0?4.0:abs(dx)<=1&&abs(dy)<=1?2.0:1.0;
        precise float wy=base/(1.0+square((cq.x-cp.x)/thresholdY));
        precise float wc=base/(1.0+.12*square((cq.x-cp.x)/thresholdY)+square((cq.y-cp.y)/thresholdC)+square((cq.z-cp.z)/thresholdC));
        sumY+=wy*cq.x;weightY+=wy;varY+=wy*square(cq.x-cp.x);
        sumR+=wc*cq.y;sumB+=wc*cq.z;weightC+=wc;
    }
    sums=vec3(sumY,sumR,sumB);weights=vec3(weightY,weightC,varY);
}
uint preparePixel(int x,int y){
    uint p=pixel(x,y);precise vec3 cp=color(x,y);
    if((p>>24)!=255u)return 0u;
    precise float sy=sigma(0,cp.x),sc=sigma(8,cp.x);
    if(sy<.40&&sc<.40)return uint(roundFloat(cp.x))<<24;
    precise vec2 flatness=guide(x,y,0,u[1],sy,sc);
    precise float legacyFlat=1.0/(1.0+square(structure(x,y,0,u[1])/(sy*3.0+3.0)));
    precise float thresholdY=max(3.0,sy*4.5),thresholdC=max(5.0,sc*5.5);
    precise vec3 sums,weights;localWork(x,y,0,u[1],thresholdY,thresholdC,cp,sums,weights);
    precise float dark=clamp((144.0-cp.x)/112.0,0.0,1.0);
    precise float strength=.60+.08*float(u[8])+(u[9]!=0?.10*dark:0.0);
    precise float localVar=weights.z/max(.001,weights.x);
    precise float ly=sy>=.40?min(.98,strength)*legacyFlat*clamp(sy*sy/max(sy*sy,localVar*.55),.12,1.0):0.0;
    precise float lc=sc>=.40?min(.99,strength+.10)*(u[10]==0?flatness.y:max(flatness.y,legacyFlat)):0.0;
    precise float targetY=sums.x/max(.001,weights.x),targetR=sums.y/max(.001,weights.y),targetB=sums.z/max(.001,weights.y);
    if(u[10]<=1&&(sy>=.60||sc>=.60)&&flatness.x>.72){
        precise vec3 nl=u[10]==1?nonlocalCoarse(x,y,sy,sc):nonlocalFine(x,y,0,u[1],sy,sc);
        precise float blend=(u[10]==1?.65:.78)*flatness.x;
        targetY=targetY*(1.0-blend)+nl.x*blend;
        targetR=targetR*(1.0-blend)+nl.y*blend;
        targetB=targetB*(1.0-blend)+nl.z*blend;
        ly=min(.98,ly+.15*flatness.x);lc=min(.99,lc+.10*flatness.y);
    }
    precise float dy=(targetY-cp.x)*ly,dr=(targetR-cp.y)*lc,db=(targetB-cp.z)*lc;
    precise float red=dy+dr,green=dy-(.299*dr+.114*db)/.587,blue=dy+db;
    return packDelta(roundFloat(cp.x),red,green,blue);
}
uint mapPixel(int map,int x,int y,int width){
    int at=(y-u[15+map])*width+x;
    return map==0?halfMap[at]:map==1?quarterMap[at]:eighthMap[at];
}
float signedByte(uint p,int shift){int value=int((p>>uint(shift))&255u);return float(value>=128?value-256:value);}
vec4 sampleMap(int map,int x,int y){
    int width=u[0],height=u[7];for(int i=0;i<=map;i++){width=halfSize(width);height=halfSize(height);}
    int scale=1<<(map+1);
    precise float fx=clamp((float(x)+.5)/float(scale)-.5,0.0,float(width-1));
    precise float fy=clamp((float(y)+.5)/float(scale)-.5,0.0,float(height-1));
    int ix=int(fx),iy=int(fy),nx=min(width-1,ix+1),ny=min(height-1,iy+1);fx-=float(ix);fy-=float(iy);
    uint a=mapPixel(map,ix,iy,width),b=mapPixel(map,nx,iy,width),c=mapPixel(map,ix,ny,width),d=mapPixel(map,nx,ny,width);
    precise vec4 result;
    for(int plane=0;plane<4;plane++){
        int shift=plane==3?24:16-plane*8;
        precise float av=plane==3?float(a>>24):signedByte(a,shift),bv=plane==3?float(b>>24):signedByte(b,shift);
        precise float cv=plane==3?float(c>>24):signedByte(c,shift),dv=plane==3?float(d>>24):signedByte(d,shift);
        result[plane]=(av*(1.0-fx)+bv*fx)*(1.0-fy)+(cv*(1.0-fx)+dv*fx)*fy;
    }
    return result;
}
uint fullPixel(int x,int row,int at,out int confidenceOut){
    confidenceOut=0;uint p=pixel(x,row);
    if((p>>24)!=255u||u[8]==0)return p;
    int budget=u[11]!=0?clamp(policy[at*2],0,256):256,detail=u[11]!=0?clamp(policy[at*2+1],0,256):0;
    if(budget==0)return p;
    precise vec3 cp=color(x,row);
    precise float sy=regionalSigma(x,row+u[6],0),sc=regionalSigma(x,row+u[6],1);
    precise vec2 flatness=guide(x,row,u[4],u[5],sy,sc);
    precise float confidenceValue=256.0*clamp((flatness.x-.65)/.30,0.0,1.0)*clamp((max(sy,sc)-.60)/1.8,0.0,1.0)*(1.0-regionalSigma(x,row+u[6],2));
    confidenceOut=roundFloat(confidenceValue);
    precise float dark=clamp((144.0-cp.x)/112.0,0.0,1.0);
    precise float thresholdY=max(2.5,sy*4.0),thresholdC=max(5.0,sc*5.0);
    precise vec3 sums,weights;localWork(x,row,u[4],u[5],thresholdY,thresholdC,cp,sums,weights);
    precise float strength=(.56+.09*float(u[8])+(u[9]!=0?.12*dark:0.0))*((160.0+float(budget)*.375)/256.0);
    precise float texture=(1.0-.55*float(detail)/256.0)*(1.0-.85*regionalSigma(x,row+u[6],2));
    precise float confidence=clamp((flatness.x-.62)/.34,0.0,1.0),residual=clamp((max(sy,sc)-.60)/3.0,0.0,1.0);
    precise float ly=sy>=.40?min(.98,strength*(.70+.30*confidence*residual))*flatness.x*texture*clamp(sy*sy/max(sy*sy,weights.z/max(.001,weights.x)*.55),.16,1.0):0.0;
    precise float lc=sc>=.40?min(.995,strength+.15*residual)*flatness.y*texture:0.0;
    precise float targetY=sums.x/max(.001,weights.x),targetR=sums.y/max(.001,weights.y),targetB=sums.z/max(.001,weights.y);
    if(confidence>.45&&residual>.15&&detail<192&&texture>.6){
        precise vec3 nl=nonlocalFine(x,row,u[4],u[5],sy,sc);
        precise float by=.84*confidence*residual,bc=.88*confidence*residual*flatness.y;
        targetY=targetY*(1.0-by)+nl.x*by;targetR=targetR*(1.0-bc)+nl.y*bc;targetB=targetB*(1.0-bc)+nl.z*bc;
        ly=min(.985,ly+.18*confidence*residual*texture);lc=min(.995,lc+.10*confidence*residual*texture);
    }
    precise float dy=(targetY-cp.x)*ly,dr=(targetR-cp.y)*lc,db=(targetB-cp.z)*lc;
    precise float dR=dy+dr,dG=dy-(.299*dr+.114*db)/.587,dB=dy+db;
    for(int k=0;k<3;k++){
        precise vec4 coarse=sampleMap(k,x,row+u[6]);
        precise float gate=1.0/(1.0+square((coarse.w-cp.x)/(sy*5.0+16.0)));
        precise float blend=(k==0?.48:k==1?.32:.22)*min(1.0,strength)*texture*gate;
        precise float cy=.299*coarse.x+.587*coarse.y+.114*coarse.z,cr=coarse.x-cy,cb=coarse.z-cy;
        precise float by=blend*(.30+.70*flatness.x),bc=blend*flatness.y;
        dR+=cy*by+cr*bc;dG+=cy*by-(.299*cr+.114*cb)/.587*bc;dB+=cy*by+cb*bc;
    }
    precise float red=float((p>>16)&255u)+dR,green=float((p>>8)&255u)+dG,blue=float(p&255u)+dB;
    return (p&0xff000000u)|(uint(byteValue(red))<<16)|(uint(byteValue(green))<<8)|uint(byteValue(blue));
}
void main(){
    int at=int(uint(u[31])+gl_GlobalInvocationID.x);if(at>=u[0]*(u[3]-u[2]))return;
    int x=at%u[0],row=u[2]+at/u[0];
    if(u[10]!=3){dst[at]=preparePixel(x,row);return;}
    int confidenceOut;dst[at]=fullPixel(x,row,at,confidenceOut);
    int ay=row+u[6];
    if(u[12]!=0&&x==min(u[0]-1,(x/4)*4+1)&&ay==min(u[7]-1,(ay/4)*4+1))
        confidenceMap[((row-u[2])/4)*((u[0]+3)/4)+x/4]=confidenceOut;
}
