  "emoji_toolbar": {
    "only_additive_method": "emojiHoldMillis(Lfc0/n2;)I",
    "prior_source_byte_equal_after_removing_added_method": true,
    "new_fields": [],
    "native_path": "fc0.n2.b (oc0.m) -> b (hc0.a) -> c (hc0.k)",
    "identity": "Existing installed(hc0.k) recognizes the private EmojiToolbar.LongPress actor installed only by the dedicated emoji-key factory.",
    "timeout": "Returns the exact positive hc0.k.a native configurable hold timeout; otherwise 0.",
    "label_coordinate_or_text_heuristics": false
  },
  "current_native_model_route": [
    "a60.s creates fb0.b0(ne0.f0, ah0.j0, i70.g1, f40.a, a20.d) in v47.",
    "a60.s invokes wb0.z1.b with v24..v69; v47 is static parameter p23.",
    "wb0.z1.b passes p23 in constructor argument register v20.",
    "wb0.x constructor assigns p20 to field t.",
    "The emoji fb0.b0 constructor stores its ne0.f0 argument in field a.",
    "Bridge receives the current wb0.x from the active gesture context and follows x.t.a; no global singleton, service lookup, or reflection."
  ],
  "recents": {
    "native_method": "ne0.e0.b()Ljava/util/ArrayList;",
    "native_order": "ArrayList of LinkedHashMap values followed by Collections.reverse; newest native live item first.",
    "bridge_order": "Preserved, without another reverse or sort.",
    "maximum_visible_items": 12,
    "text_handling": "Each valid ne0.g0.getContent() is kept as the complete String. No code point extraction, normalization, truncation, or splitting is applied by the bridge.",
    "empty_history": "An empty immutable snapshot; no substituted stock emoji.",
    "invalid_native_graph": "Returns null without intercepting a native emoji action.",
    "persistent_native_history": "xc.d.m writes emoji_recent_tab_keys through the native ne0.f0.b -> uf.p.b -> ah0.w0 provider; the bridge never opens a preference file.",
    "native_capacity": 32
  },
  "insertion_and_history": {
    "selected_location": "oz.j2.a = RECENTS",
    "first": "wb0.x.G(lh0.a, full String, oz.j2.a)",
    "second": "new xc.d(current ne0.f0, 14).l(new ne0.p0(full String), 1)",
    "precedent": "Native i70.p1.invoke branch for ne0.g0 calls wb0.x.G, then new xc.d(model,14).l(pushable,1). The bridge uses RECENTS instead of that branch's ALL_TAB location.",
    "native_history_dispatch": "xc.d.l calls m(recency), o(usage weighting), then c20.a.f(1, native recents model).",
    "privacy": "Both xc.d.m and xc.d.o invoke vb0.c.b() before history/usage mutation. b() is false only for INCOGNITO_OFF; ON, PENDING_OFF and TEMPORARILY_ON suppress changes. The bridge delegates to these native guards unchanged.",
    "composition": "G routes RECENTS through the native yb0.l emoji action; no direct InputConnection.commitText fallback.",
    "attempt_limit": "Snapshot.commit is synchronized and marks used before validation/native calls, so repeated release callbacks or exceptions cannot trigger a second native insertion.",
    "stale_graph": "Checks identity of sender.t, provider.a, and history.f before insertion; runtime separately guards the editor/session/layout.",
    "history_failure": "After G returns normally, a history exception is swallowed and no insertion retry is made.",
    "diagnostic_text_or_logs": false
  },
