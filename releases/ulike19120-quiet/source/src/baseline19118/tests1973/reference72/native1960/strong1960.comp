#version 310 es
#extension GL_EXT_gpu_shader5 : require
/* GX1/GX2/GX4/GX7: NR9--NR13 unchanged single-image computation.
 * No search reduction, precision reduction, synthetic detail or frame merging.
 * GL_EXT_gpu_shader5 precise prevents contraction/reassociation; every device
 * must additionally pass the Java oracle admission before this shader is used.
 * Binding 0: immutable ARGB source band, row u[14] is its first row.
 * Binding 1: packed preparation delta or full ARGB, core rows only.
 * Binding 2: 16 noise bins then interleaved regional Y/C/detail evidence;
 *            regional grid row u[13] is first retained row.
 * Binding 3: optional core-only interleaved budgetQ8/detailQ8.
 * Binding 4/5/6: immutable half/quarter/eighth delta maps, first rows u[15..17].
 * Binding 7: sparse NR13 confidence, ceil(width/4)*ceil(coreRows/4) integers;
 *            allocate/clear before dispatch. One owning invocation per cell.
 * u[0]=width,u[1]=source rows,u[2]=begin,u[3]=end,u[4]=validBegin,
 * u[5]=validEnd,u[6]=originY,u[7]=fullHeight,u[8]=noise,u[9]=shadows,
 * u[10]=mode (0 half prep,1 quarter prep,2 eighth prep,3 full),
 * u[11]=hasPolicy,u[12]=captureConfidence,u[13]=firstGridY,
 * u[14]=sourceFirstY,u[15..17]=mapFirstY. f[] unused.
 * u[31]=global invocation base for a stripe; groupStart*localSize for tile8.
 * Stripe dispatch: ceil(width*(end-begin)/localSize) workgroups.
 * Tile8 dispatch: ceil(width/8)*ceil((end-begin)/(localSize/8)) workgroups.
 */
precision highp float;
precision highp int;
#ifndef GX_LOCAL_SIZE
#define GX_LOCAL_SIZE 64
#endif
#ifndef GX_STRONG_MODE
#define GX_STRONG_MODE -1
#endif
#ifndef GX_TILE_WIDTH
#define GX_TILE_WIDTH 0
#endif
#if GX_STRONG_MODE >= 0
#define STRONG_MODE GX_STRONG_MODE
#else
#define STRONG_MODE u[10]
#endif
// GX27: compile each preparation/full mode with exactly its original support.
// No NLM candidate or patch observation is removed. Generic mode keeps radius7.
#if GX_STRONG_MODE == 2
#define GX_CACHE_RADIUS 3
#elif GX_STRONG_MODE == 0 || GX_STRONG_MODE == 3
#define GX_CACHE_RADIUS 5
#else
#define GX_CACHE_RADIUS 7
#endif
layout(local_size_x=GX_LOCAL_SIZE,local_size_y=1,local_size_z=1) in;
layout(std430,binding=0) readonly buffer Source1960 { uint src[]; };
layout(std430,binding=1) writeonly buffer Output1960 { uint dst[]; };
layout(std430,binding=2) readonly buffer Evidence1960 { float evidence[]; };
layout(std430,binding=3) readonly buffer Policy1960 { int policy[]; };
layout(std430,binding=4) readonly buffer Half1960 { uint halfMap[]; };
layout(std430,binding=5) readonly buffer Quarter1960 { uint quarterMap[]; };
layout(std430,binding=6) readonly buffer Eighth1960 { uint eighthMap[]; };
layout(std430,binding=7) writeonly buffer Confidence1960 { int confidenceMap[]; };
uniform int u[32];
uniform float f[32];

/* GX16/GX27: immutable packed pixels and their unchanged scalar luma are loaded
 * cooperatively once for this linear workgroup's support. Each vertical row
 * covers GX_LOCAL_SIZE+2*radius adjacent source positions; crossings use
 * their actual source row. Full/half needs radius5, quarter NLM radius7,
 * eighth preparation radius3. The
 * cache contains all original 8x5/24x9 observations; no reduction/reordering.
 * GX33 additionally retains the exact scalar red/blue chroma and uses a
 * rectangular output tile for specialized programs. The engine accounts for
 * all pixel/chroma/difference bytes before compilation; every candidate also
 * needs unchanged-output admission and actual complete-path device timing.
 */
#if GX_TILE_WIDTH > 0
// GX33: a real 2D output tile. The engine dispatches ceil(width/8) by
// ceil(coreRows/(localSize/8)) tiles, and u[31] is groupStart*localSize.
const int TILE_HEIGHT=GX_LOCAL_SIZE/GX_TILE_WIDTH;
const int CACHE_PITCH=GX_TILE_WIDTH+2*GX_CACHE_RADIUS;
const int CACHE_ROWS=TILE_HEIGHT+2*GX_CACHE_RADIUS;
#else
const int CACHE_PITCH=GX_LOCAL_SIZE+2*GX_CACHE_RADIUS;
const int CACHE_ROWS=2*GX_CACHE_RADIUS+1;
#endif
const int CACHE_COUNT=CACHE_PITCH*CACHE_ROWS;
shared uint cachedPixels[CACHE_COUNT];
shared float cachedLuma[CACHE_COUNT];
// The 2D shape is small enough to retain both unchanged scalar chroma
// components at all sizes. A large legacy 128-lane stripe keeps its original
// 8B/pixel cache to remain below the GLES minimum 32KiB shared-memory limit.
#if GX_TILE_WIDTH > 0 || GX_LOCAL_SIZE <= 64
#define GX_CACHE_CHROMA 1
shared float cachedRed[CACHE_COUNT];
shared float cachedBlue[CACHE_COUNT];
#else
#define GX_CACHE_CHROMA 0
#endif
#if GX_TILE_WIDTH > 0 && GX_STRONG_MODE != 2
#define GX_DIFF_CACHE 1
#if GX_STRONG_MODE == 1 || GX_STRONG_MODE < 0
const int DIFF_RADIUS=7;
const int DIFF_OFFSETS=12;
#else
const int DIFF_RADIUS=5;
const int DIFF_OFFSETS=4;
#endif
// For a negative candidate displacement, the same squared distance is read
// from its reverse pair. Only the lower half of candidate orientations needs
// storage. Patch positions extend one pixel beyond the output tile.
const int DIFF_PITCH=GX_TILE_WIDTH+DIFF_RADIUS+1;
const int DIFF_ROWS=TILE_HEIGHT+DIFF_RADIUS+1;
const int DIFF_PLANE=DIFF_PITCH*DIFF_ROWS;
shared float cachedDistance[DIFF_OFFSETS*DIFF_PLANE];
#else
#define GX_DIFF_CACHE 0
#endif
int centerX=0,centerY=0,centerLane=0,tileX=0,tileY=0;
bool cacheReady=false;
float rawLuma(uint p){
    precise float result=.299*float((p>>16)&255u)+.587*float((p>>8)&255u)+.114*float(p&255u);
    return result;
}
uint rawPixel(int x,int y){
    x=clamp(x,0,u[0]-1);y=clamp(y,0,u[1]-1);
    return src[(y-u[14])*u[0]+x];
}
int cacheAt(int x,int y){
#if GX_TILE_WIDTH > 0
    int col=x-tileX+GX_CACHE_RADIUS,dy=y-tileY+GX_CACHE_RADIUS;
#else
    int col=centerLane+x-centerX+GX_CACHE_RADIUS,dy=y-centerY+GX_CACHE_RADIUS;
#endif
    return col>=0&&col<CACHE_PITCH&&dy>=0&&dy<CACHE_ROWS?dy*CACHE_PITCH+col:-1;
}
vec3 cacheColor(int x,int y){
    x=clamp(x,0,u[0]-1);y=clamp(y,0,u[1]-1);
    int at=cacheReady?cacheAt(x,y):-1;
    uint p=at>=0?cachedPixels[at]:rawPixel(x,y);
    precise float yy=at>=0?cachedLuma[at]:rawLuma(p);
#if GX_CACHE_CHROMA
    if(at>=0)return vec3(yy,cachedRed[at],cachedBlue[at]);
#endif
