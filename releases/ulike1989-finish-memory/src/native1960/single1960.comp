#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_gpu_shader5 : require
precision highp float;
precision highp int;
#define D float64_t
/* GX1: the unchanged 1955 single-image transform/filter/residual safeguard.
 * Requires true fp64. Never substitute float for D: unsupported drivers must
 * reject compilation and keep the current CPU oracle. The two-pass gathering
 * avoids unordered float atomics, visiting the original by,bx,8,4 sequence.
 */
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Source {uint pixels[];};
layout(std430,binding=1) writeonly buffer Result {uint result[];};
layout(std430,binding=2) readonly buffer Model {float model[];};
layout(std430,binding=3) readonly buffer Policy {int policy[];};
layout(std430,binding=4) buffer Scratch {float scratch[];};
uniform int u[32];
uniform float f[32];
const float WINDOW8[8]=float[8](.03806023,.30865828,.6913417,.96193975,
    .96193975,.6913417,.30865828,.03806023);
const D D4[8]=D[8](.5LF,.5LF,.65328148243818829LF,.27059805007309856LF,
    .50000000000000011LF,-.5LF,.27059805007309856LF,-.6532814824381884LF);
const D D8[32]=D[32](
    .35355339059327379LF,.35355339059327379LF,.35355339059327379LF,.35355339059327379LF,
    .49039264020161522LF,.41573480615127262LF,.27778511650980114LF,.097545161008064166LF,
    .46193976625564337LF,.19134171618254492LF,-.19134171618254486LF,-.46193976625564337LF,
    .41573480615127262LF,-.097545161008064096LF,-.49039264020161522LF,-.27778511650980109LF,
    .35355339059327379LF,-.35355339059327373LF,-.35355339059327384LF,.35355339059327368LF,
    .27778511650980114LF,-.49039264020161522LF,.097545161008064152LF,.41573480615127273LF,
    .19134171618254492LF,-.46193976625564342LF,.46193976625564326LF,-.19134171618254495LF,
    .097545161008064166LF,-.27778511650980109LF,.41573480615127273LF,-.49039264020161533LF);
D basis(int n,int k,int x){return n==8?D8[k*4+x]:D4[k*2+x];}
D luma(uint p){precise D y=.299LF*D((p>>16)&255u)+.587LF*D((p>>8)&255u)+.114LF*D(p&255u);return y;}
void transform(inout D values[64],int n,bool inverse) {
    precise D temp[64];
    if(!inverse) {
        for(int row=0;row<n;row++)for(int k=0;k<n;k++) {
            precise D sum=0.0LF;
            for(int x=0;x<n/2;x++)sum+=(values[row*n+x]+((k&1)==0?values[row*n+n-1-x]:-values[row*n+n-1-x]))*basis(n,k,x);
            temp[row*n+k]=sum;
        }
        for(int col=0;col<n;col++)for(int k=0;k<n;k++) {
            precise D sum=0.0LF;
            for(int y=0;y<n/2;y++)sum+=(temp[y*n+col]+((k&1)==0?temp[(n-1-y)*n+col]:-temp[(n-1-y)*n+col]))*basis(n,k,y);
            values[k*n+col]=sum;
        }
    } else {
        for(int col=0;col<n;col++)for(int y=0;y<n/2;y++) {
            precise D even=0.0LF,odd=0.0LF;
            for(int k=0;k<n;k++){precise D v=values[k*n+col]*basis(n,k,y);if((k&1)==0)even+=v;else odd+=v;}
            temp[y*n+col]=even+odd;temp[(n-1-y)*n+col]=even-odd;
        }
        for(int row=0;row<n;row++)for(int x=0;x<n/2;x++) {
            precise D even=0.0LF,odd=0.0LF;
            for(int k=0;k<n;k++){precise D v=temp[row*n+k]*basis(n,k,x);if((k&1)==0)even+=v;else odd+=v;}
            values[row*n+x]=even+odd;values[row*n+n-1-x]=even-odd;
        }
    }
}
float interpolate(int offset,int x,int y) {
    precise float left=float(u[11]-1)*.5,top=float(u[12]-1)*.5;
    precise float stepX=u[9]==1?1.0:float(u[1]-u[11])/float(u[9]-1);
    precise float stepY=u[10]==1?1.0:float(u[2]-u[12])/float(u[10]-1);
    precise float xx=u[9]==1?0.0:clamp((float(x)-left)/stepX,0.0,float(u[9]-1));
    precise float yy=u[10]==1?0.0:clamp((float(y)-top)/stepY,0.0,float(u[10]-1));
    int ix=int(xx),iy=int(yy),nx=min(u[9]-1,ix+1),ny=min(u[10]-1,iy+1);
    precise float fx=xx-float(ix),fy=yy-float(iy);
    precise float a=model[offset+iy*u[9]+ix]*(1.0-fx)+model[offset+iy*u[9]+nx]*fx;
    precise float b=model[offset+ny*u[9]+ix]*(1.0-fx)+model[offset+ny*u[9]+nx]*fx;
    precise float v=a*(1.0-fy)+b*fy;return v;
}
float brightness(int offset,float mean) {
    precise float x=clamp((mean-16.0)/32.0,0.0,7.0);
    int a=int(x),b=min(7,a+1);
    precise float v=model[offset+a]*(1.0-(x-float(a)))+model[offset+b]*(x-float(a));return v;
}
float sigma(int x,int y,float blockMean,int color) {
    int cells=u[9]*u[10];
    precise float base=interpolate(color==0?0:cells,x,y);
    if(base<.30)return 0.0;
    precise float sampled=interpolate(cells*2,x,y);
    int offset=cells*3+color*8;
    precise float reference=brightness(offset,sampled),current=brightness(offset,blockMean);
    precise float v=base*clamp(reference>.3?current/reference:1.0,.65,1.55);return v;
}
D lag(D values[64],int n,int distance) {
    precise D numerator=0.0LF,a=0.0LF,b=0.0LF;
    for(int y=0;y<n;y++)for(int x=0;x<n-distance;x++) {
        precise D p=values[y*n+x],q=values[y*n+x+distance];
        numerator+=p*q;a+=p*p;b+=q*q;
    }
    for(int y=0;y<n-distance;y++)for(int x=0;x<n;x++) {
        precise D p=values[y*n+x],q=values[(y+distance)*n+x];
        numerator+=p*q;a+=p*p;b+=q*q;
    }
    precise D v=a*b<1e-9LF?0.0LF:numerator/sqrt(a*b);return v;
}
float safeguard(D source[64],D residual[64],int n,float sy) {
    precise D energy=0.0LF;for(int i=0;i<n*n;i++)energy+=residual[i]*residual[i];
    if(energy<.0001LF)return 1.0;
    precise D r1=lag(residual,n,1),r2=lag(residual,n,2),r4=n==8?lag(residual,n,4):0.0LF;
    precise D periodic=max(r2>.25LF&&r1<-.15LF?r2:0.0LF,r4>.25LF&&r2<-.15LF?r4:0.0LF);
    precise float keep=1.0-clamp(float(periodic-.25LF)/.5,0.0,1.0)*.88;
    for(int vertical=0;vertical<2;vertical++) {
        precise D coherentEdge=0.0LF,removed=0.0LF;int count=0;
        for(int k=0;k<n;k++) {
            precise D a=0.0LF,b=0.0LF,ra=0.0LF,rb=0.0LF;
            for(int j=0;j<n/2;j++) {
                int ia=vertical==0?k*n+j:j*n+k;
                int ib=vertical==0?k*n+j+n/2:(j+n/2)*n+k;
                a+=source[ia];b+=source[ib];ra+=residual[ia];rb+=residual[ib];
            }
            precise D edge=(b-a)/D(n/2),lost=(rb-ra)/D(n/2);
            if(abs(edge)>max(3.0LF,D(sy)*1.4LF)){coherentEdge+=edge;removed+=lost;count++;}
        }
        /* sy*n is intentionally evaluated at float precision in the oracle. */
        precise float threshold=max(8.0,sy*float(n));
        if(count>=n/2&&abs(coherentEdge)>D(threshold)&&removed*coherentEdge>0.0LF&&abs(removed)>abs(coherentEdge)*.015LF)keep=min(keep,.18);
    }
    return keep;
}
void block(int bx,int by,int n,int base) {
    scratch[base]=0.0;
    if(by+n<=u[4]+u[6]||by>=u[5]+u[6]||bx+n<=0)return;
    precise D sourceY[64],source[64],coefficient[64],residual[64];
    precise D mean=0.0LF;bool opaque=true;
    for(int yy=0;yy<n;yy++)for(int xx=0;xx<n;xx++) {
        int gx=clamp(bx+xx,0,u[1]-1),gy=clamp(by+yy,0,u[2]-1)-u[6];
        if(gy<u[7]||gy>=u[8])return;
        uint p=pixels[gy*u[1]+gx];int at=yy*n+xx;precise D y=luma(p);
        if((p>>24)!=255u)opaque=false;
        sourceY[at]=y;mean+=y;
    }
    if(!opaque)return;
    mean/=D(n*n);
    int cx=clamp(bx+n/2,0,u[1]-1),cy=clamp(by+n/2,0,u[2]-1);
    precise float sy=sigma(cx,cy,float(mean),0),sc=sigma(cx,cy,float(mean),1);
    if(sy<.30&&sc<.30)return;
    precise float strength=.35+float(u[13])*.21;
    if(u[14]!=0)strength*=1.0+.12*clamp((128.0-float(mean))/96.0,0.0,1.0);
    int bin=clamp(int(float(mean))/32,0,7);
    precise float keep=1.0;
    for(int plane=0;plane<3;plane++) {
        precise float variance[3];
        for(int band=0;band<3;band++) {
            precise float shape=model[u[9]*u[10]*3+16+(bin*3+plane)*3+band];
            precise float s=plane==0?sy:sc;
            variance[band]=s*s*shape*shape*strength;
        }
        for(int yy=0;yy<n;yy++)for(int xx=0;xx<n;xx++) {
            int at=yy*n+xx;
            if(plane==0)source[at]=sourceY[at];
            else {
                int gx=clamp(bx+xx,0,u[1]-1),gy=clamp(by+yy,0,u[2]-1)-u[6];
                uint p=pixels[gy*u[1]+gx];
                source[at]=D(plane==1?((p>>16)&255u):(p&255u))-sourceY[at];
            }
            coefficient[at]=source[at];
        }
        transform(coefficient,n,false);
        for(int v=0;v<n;v++)for(int x=0;x<n;x++) {
            if(x+v==0)continue;
            int at=v*n+x,frequency=(x+v)*8/n,band=frequency<4?0:frequency<8?1:2;
            precise D c=coefficient[at];precise float vr=variance[band];
            if(plane==0&&x+v==1)vr*=.32;
            precise D power=c*c;
            /* oracle's variance*36 is float, variance*1.25 is double. */
            precise float threshold=vr*36.0;
            if(vr<=.03||power>D(threshold))continue;
            precise D gain=power/(power+D(vr)*1.25LF);coefficient[at]=c*gain;
        }
        transform(coefficient,n,true);
        for(int i=0;i<n*n;i++) {
            precise D delta=coefficient[i]-source[i];
            scratch[base+2+plane*n*n+i]=float(delta);
            if(plane==0)residual[i]=-delta;
        }
        if(plane==0)keep=safeguard(sourceY,residual,n,sy);
    }
    scratch[base+1]=keep;scratch[base]=1.0;
}
void addBlock(int bx,int by,int n,int base,int ax,int ay,int outIndex,
        inout float weightSum,inout vec3 deltaSum) {
    if(scratch[base]==0.0||ax<bx||ax>=bx+n||ay<by||ay>=by+n)return;
    int xx=ax-bx,yy=ay-by,at=yy*n+xx;
    precise float blend=scratch[base+1];
    if(u[15]!=0) {
        int budget=clamp(policy[outIndex*2],0,256),detail=clamp(policy[outIndex*2+1],0,256);
        blend*=float(budget)/256.0*(1.0-float(detail)/256.0);
    }
    precise float weight=n==8?.82*WINDOW8[xx]*WINDOW8[yy]:.18;
    weightSum+=weight;
    for(int plane=0;plane<3;plane++) {
        precise float delta=scratch[base+2+plane*n*n+at]*weight*blend;
        deltaSum[plane]+=delta;
    }
}
int byteValue(float value){return clamp(int(floor(D(value)+.5LF)),0,255);}
void main() {
    uint id=uint(u[31])+gl_GlobalInvocationID.x;
    if(u[0]==0) {
        if(id>=uint(u[17]*u[18]))return;
        int bx=(int(id)%u[17])*4-4,by=u[16]+(int(id)/u[17])*4,base=int(id)*248;
        block(bx,by,8,base);
        scratch[base+196]=0.0;
        if(by+4>u[4]+u[6]&&bx>=0)block(bx,by,4,base+196);
        return;
    }
    int count=u[1]*(u[5]-u[4]);if(id>=uint(count))return;
    int ax=int(id)%u[1],localY=int(id)/u[1]+u[4],ay=localY+u[6];
    uint p=pixels[localY*u[1]+ax];
    if((p>>24)!=255u){result[id]=p;return;}
    precise float weight=0.0;precise vec3 delta=vec3(0.0);
    int by0=(ay/4)*4-4,bx0=(ax/4)*4-4;
    for(int by=by0;by<=by0+4;by+=4)for(int bx=bx0;bx<=bx0+4;bx+=4) {
        int row=(by-u[16])/4,col=(bx+4)/4;
        if(by<u[16]||row>=u[18]||col<0||col>=u[17])continue;
        int base=(row*u[17]+col)*248;
        addBlock(bx,by,8,base,ax,ay,int(id),weight,delta);
        addBlock(bx,by,4,base+196,ax,ay,int(id),weight,delta);
    }
    if(weight==0.0){result[id]=p;return;}
    precise float dy=delta[0]/weight,dr=delta[1]/weight,db=delta[2]/weight;
    precise float r=float((p>>16)&255u)+dy+dr,b=float(p&255u)+dy+db;
    precise float g=float((p>>8)&255u)+dy-(.299*dr+.114*db)/.587;
    result[id]=(p&0xff000000u)|(uint(byteValue(r))<<16)|(uint(byteValue(g))<<8)|uint(byteValue(b));
}
