layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(std430,binding=0) readonly buffer Source {uint pixels[];};
layout(std430,binding=1) writeonly buffer Result {uint result[];};
layout(std430,binding=2) readonly buffer Residuals {float records[];};
layout(std430,binding=3) readonly buffer Protection {int policy[];};
uniform highp int u[32];
uniform highp float f[32];
const float WINDOW8[8]=float[8](.03806023,.30865828,.6913417,.96193975,
    .96193975,.6913417,.30865828,.03806023);
void addBlock(int bx,int by,int n,int base,int ax,int ay,int policyIndex,
        inout float weightSum,inout vec3 deltaSum) {
    if(records[base]==0.0||ax<bx||ax>=bx+n||ay<by||ay>=by+n)return;
    int xx=ax-bx,yy=ay-by,at=yy*n+xx;
    precise float blend=records[base+1];
    if(u[15]!=0) {
        int budget=clamp(policy[policyIndex*2],0,256),detail=clamp(policy[policyIndex*2+1],0,256);
        blend*=float(budget)/256.0*(1.0-float(detail)/256.0);
    }
    precise float weight=n==8?.82*WINDOW8[xx]*WINDOW8[yy]:.18;
    precise float nextWeight=weightSum+weight;weightSum=nextWeight;
    for(int plane=0;plane<3;plane++) {
