            precise float yy=u[10]==1?0.0:clamp(ieeeDiv1973(float(y)-f[2],f[4]),0.0,float(u[10]-1));
            int ix=min(u[9]-1,int(xx)),iy=min(u[10]-1,int(yy)),nx=min(u[9]-1,ix+1),ny=min(u[10]-1,iy+1);xx=xx-float(ix);yy=yy-float(iy);
            precise float a=model.data[iy*u[9]+ix]*(1.0-xx);a=a+model.data[iy*u[9]+nx]*xx;
            precise float b=model.data[ny*u[9]+ix]*(1.0-xx);b=b+model.data[ny*u[9]+nx]*xx;
            precise float sigma=a*(1.0-yy);sigma=sigma+b*yy;values.data[id]=sigma;
        } else values.data[id]=f[0];
    }
}
