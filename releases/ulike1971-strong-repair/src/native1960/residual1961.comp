        precise float next=deltaSum[plane]+delta;deltaSum[plane]=next;
    }
}
/* Java1955 promotes value to double before adding .5. The floor+fraction
 * threshold gives that exact rounding without falsely rounding127.499992
 * upward when a float value+.5 rounds to128.0. */
int byteValue(float value) {
    if(value<=0.0)return 0;if(value>=255.0)return 255;
    precise float whole=floor(value),fraction=value-whole;
    return int(whole)+(fraction>=.5?1:0);
}
void main() {
