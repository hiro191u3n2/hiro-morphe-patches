#version 310 es
#extension GL_EXT_gpu_shader5 : require
precision highp float;
precision highp int;
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(std430,binding=0) readonly buffer Source {uint pixels[];} source;
layout(std430,binding=1) writeonly buffer Destination {int values[];} destination;
layout(std430,binding=2) readonly buffer Policy {int values[];} policy;
layout(std430,binding=3) readonly buffer Geometry {int values[];} geometry;
layout(std430,binding=4) readonly buffer Grid {float values[];} grid;
layout(std430,binding=5) readonly buffer Masks {int values[];} masks;
uniform highp int u[32];
uniform highp float f[32];
// .92: preserve Java binary32 division before exact policy rounding.
bool divGreater1973(uint ah,uint al,uint bh,uint bl){return ah>bh||(ah==bh&&al>bl);}
uint divFloor1973(uint a,uint b,int shift){
    uint q=1u,r=a-b;
    for(int bit=0;bit<23;bit++)if(bit<shift){
        r<<=1;q<<=1;
        if(r>=b){r-=b;q|=1u;}
    }
    return q;
}
uint ieeeDivBits1973(uint ax,uint bx){
    uint sign=(ax^bx)&0x80000000u,a=ax&0x7fffffffu,b=bx&0x7fffffffu;
    if(a>0x7f800000u||b>0x7f800000u)return 0x7fc00000u;
    if(a==0x7f800000u)return b==0x7f800000u?0x7fc00000u:sign|0x7f800000u;
    if(b==0x7f800000u)return sign;
    if(b==0u)return a==0u?0x7fc00000u:sign|0x7f800000u;
    if(a==0u)return sign;
    int ea=int(a>>23)-127,eb=int(b>>23)-127;
    uint ma=(a&0x007fffffu)|0x00800000u,mb=(b&0x007fffffu)|0x00800000u;
    if((a>>23)==0u){int normal=23-findMSB(a);ma=a<<uint(normal);ea=-126-normal;}
    if((b>>23)==0u){int normal=23-findMSB(b);mb=b<<uint(normal);eb=-126-normal;}
    int exponent=ea-eb+127;
    if(ma<mb){ma<<=1;exponent--;}
    if(exponent>=255)return sign|0x7f800000u;
    if(exponent<-23)return sign;
    // Exactly half the minimum subnormal ties to zero. Greater ratios round
    // up; reduced precision is selected before rounding, never double-rounded.
    if(exponent==-23)return sign|(ma>mb?1u:0u);
    int shift=exponent>0?23:exponent+22;
    uint nh=shift==0?0u:ma>>uint(32-shift),nl=ma<<uint(shift);
    precise float guess=float(ma)/float(mb);
    precise float scaled=guess*uintBitsToFloat(uint(shift+127)<<23);
    uint q=uint(scaled);
    #ifdef GX_DIV_GUESS_PERTURB73
    q=uint(max(0,int(q)+GX_DIV_GUESS_PERTURB73));
    #endif
    uint ph=0u,pl=0u;
    bool verified=false;
    for(int correction=0;correction<8;correction++){
        umulExtended(mb,q,ph,pl);
        if(divGreater1973(ph,pl,nh,nl)){if(q==0u)break;q--;continue;}
        uint nextLo=pl+mb,nextHi=ph+(nextLo<pl?1u:0u);
        if(!divGreater1973(nextHi,nextLo,nh,nl)){q++;continue;}
        verified=true;break;
    }
    if(!verified){q=divFloor1973(ma,mb,shift);umulExtended(mb,q,ph,pl);}
    // The validated difference is <mb<2^24; modulo low-word subtraction is
    // exact even when the 48-bit subtraction borrows from its high word.
    uint remainder=nl-pl,twice=remainder<<1;
    if(twice>mb||(twice==mb&&(q&1u)!=0u))q++;
    if(exponent<=0)return sign|q;
    if(q==0x01000000u){q>>=1;exponent++;}
    if(exponent>=255)return sign|0x7f800000u;
    return sign|(uint(exponent)<<23)|(q&0x007fffffu);
}
float ieeeDiv1973(float a,float b){return uintBitsToFloat(ieeeDivBits1973(floatBitsToUint(a),floatBitsToUint(b)));}

int luma(uint p){return (77*int((p>>16u)&255u)+150*int((p>>8u)&255u)+29*int(p&255u)+128)>>8;}
int javaRound(float value) {
    int bits=floatBitsToInt(value),exponent=(bits>>23)&255,shift=149-exponent;
    if((shift&~31)==0){int mantissa=(bits&0x7fffff)|0x800000;if(bits<0)mantissa=-mantissa;return ((mantissa>>shift)+1)>>1;}
    return int(value);
}
void main() {
    int id=u[31]+int(gl_GlobalInvocationID.x);
    if(u[0]==0) {
        if(id>=u[4])return;
        bool visited=false;
        for(int face=0;face<u[3];face++)visited=visited||((geometry.values[face*u[4]+id]&65536)!=0);
        if(!visited){destination.values[id*2]=0;destination.values[id*2+1]=0;return;}
        int x=id%u[1],y=id/u[1],lo=255,hi=0;
        for(int yy=max(0,y-1);yy<=min(u[2]-1,y+1);yy++)for(int xx=max(0,x-1);xx<=min(u[1]-1,x+1);xx++) {
            int value=luma(source.pixels[yy*u[1]+xx]);lo=min(lo,value);hi=max(hi,value);
        }
        uint p=source.pixels[id];int r=int((p>>16u)&255u),g=int((p>>8u)&255u),b=int(p&255u);
        bool skin=luma(p)>=28 && r>=g-10 && r>b+2 && max(r,max(g,b))-min(r,min(g,b))>6;
        int admitted=0,protectedValue=0;
        for(int face=0;face<u[3];face++) {
            int packedMask=geometry.values[face*u[4]+id];if((packedMask&65536)==0)continue;
            int eligibility=packedMask&255,protect=(packedMask>>8)&255;
            eligibility=skin?eligibility*max(0,48-(hi-lo))/48:0;
            eligibility=eligibility*(255-protect)/255;
            admitted=max(admitted,eligibility);protectedValue=max(protectedValue,protect);
        }
        destination.values[id*2]=admitted;destination.values[id*2+1]=protectedValue;
    } else if(u[0]==1) {
        if(id>=u[8])return;
        int x=(id%u[7])*4,row=u[3]+(id/u[7])*4,y=row+u[5],minimum=256;
        for(int dy=0;dy<4&&y+dy<u[6];dy++)for(int dx=0;dx<4&&x+dx<u[1];dx++) {
            int rr=row+dy,c=x+dx;
            if(rr>=u[2] || (source.pixels[rr*u[1]+c]>>24u)!=255u){minimum=0;continue;}
            int at=((rr-u[3])*u[1]+c)*2;
            int budget=(policy.values[at]*(256-policy.values[at+1]))>>8;
            minimum=min(minimum,budget);
        }
        destination.values[id]=min(255,(geometry.values[id]*minimum)>>8);
    } else if(u[0]==2||u[0]==3) {
        if(id>=u[1]*u[2])return;
        int x=id%u[1],y=id/u[1]+u[3];precise float sigma=f[0];
        if(u[6]!=0) {
            precise float gx=u[4]==1?0.0:clamp(ieeeDiv1973(float(x)-f[2],f[4]),0.0,float(u[4]-1));
            precise float gy=u[5]==1?0.0:clamp(ieeeDiv1973(float(y)-f[3],f[5]),0.0,float(u[5]-1));
            int ix=min(u[4]-1,int(gx)),iy=min(u[5]-1,int(gy));
            int nx=min(u[4]-1,ix+1),ny=min(u[5]-1,iy+1);
            precise float fx=gx-float(ix),fy=gy-float(iy);
            precise float a0=grid.values[iy*u[4]+ix]*(1.0-fx),a1=grid.values[iy*u[4]+nx]*fx;
            precise float b0=grid.values[ny*u[4]+ix]*(1.0-fx),b1=grid.values[ny*u[4]+nx]*fx;
            precise float a=a0+a1,b=b0+b1;
            precise float ay=a*(1.0-fy),by=b*fy;sigma=ay+by;
        }
        sigma=sigma*f[1];
        // New resident mode receives one exact Java-sampled skin/smooth pair,
        // or one zero word when masks are absent. Legacy mode2 remains RAW2.
        int packedMask=u[0]==3?masks.values[u[11]!=0?0:id]:0;
        int confidence=u[0]==3?int(uint(packedMask)>>16u):masks.values[id*2+1];
        int skin=u[0]==3?(packedMask&65535):masks.values[id*2];
        precise float toleranceProduct=sigma*.65;int tolerance=3+javaRound(toleranceProduct);
        precise float floorProduct=sigma*1.8;precise float floorBase=1.0+floorProduct;precise float floorScaled=floorBase*256.0;
        int noiseFloor=max(u[7],javaRound(floorScaled));
        if(confidence!=0) {
            tolerance=tolerance+((u[8]*confidence)>>8);
            int admittedFloor=max(noiseFloor,u[9]);noiseFloor=noiseFloor+(((admittedFloor-noiseFloor)*confidence)>>8);
        }
        precise float darkProduct=sigma*.75;
        destination.values[id*4]=tolerance;
        destination.values[id*4+1]=max(3,javaRound(darkProduct));
        destination.values[id*4+2]=noiseFloor;
        destination.values[id*4+3]=256-(int(uint(skin)*uint(u[10]))>>8);
    }
}
