    return vec3(yy,rr,bb);
}
float pairDistance(vec3 ca,vec3 cb){
    // Exact original expression, including the multiplication/addition order.
    precise float dy=ca.x-cb.x,dr=ca.y-cb.y,db=ca.z-cb.z;
    precise float result=dy*dy+.11*(dr*dr+db*db);
    return result;
}
#if GX_DIFF_CACHE
ivec2 differenceOffset(int offset){
    if(STRONG_MODE==1){
        if(offset<2)return ivec2((offset+1)*3,0);
        return ivec2(((offset-2)%5-2)*3,((offset-2)/5+1)*3);
    }
    return offset==0?ivec2(4,0):ivec2((offset-2)*4,4);
}
void fillDifferences(int first,int last){
    int count=STRONG_MODE==1?12:4;
    for(int at=int(gl_LocalInvocationIndex);at<count*DIFF_PLANE;at+=GX_LOCAL_SIZE){
        int offset=at/DIFF_PLANE,pos=at%DIFF_PLANE;
        int x=tileX+pos%DIFF_PITCH-DIFF_RADIUS;
        int y=tileY+pos/DIFF_PITCH-DIFF_RADIUS;
        ivec2 delta=differenceOffset(offset);
        // Extra unused support never reads outside the immutable supplied band.
        precise vec3 ca=cacheColor(x,clamp(y,first,last));
        precise vec3 cb=cacheColor(x+delta.x,clamp(y+delta.y,first,last));
        cachedDistance[at]=pairDistance(ca,cb);
    }
    barrier();
}
#endif
void fillCache(){
    int groupBase=int(uint(u[31])+gl_WorkGroupID.x*uint(GX_LOCAL_SIZE));
    int sourceBase=u[2]*u[0]+groupBase;
    int radius=STRONG_MODE==1?7:STRONG_MODE==2?3:5;
    int first=max(u[14],max(u[4],u[2]-radius));
    int last=min(u[5],u[3]+radius)-1;
    for(int at=int(gl_LocalInvocationIndex);at<CACHE_COUNT;at+=GX_LOCAL_SIZE){
        int col=at%CACHE_PITCH,dy=at/CACHE_PITCH-GX_CACHE_RADIUS;
#if GX_TILE_WIDTH > 0
        int x=clamp(tileX+col-GX_CACHE_RADIUS,0,u[0]-1),y=clamp(tileY+dy,first,last);
#else
        // Invalid trailing lanes still join the barrier. Their unused support
        // loads are clamped into the supplied immutable source band.
        int logical=clamp(sourceBase+col-GX_CACHE_RADIUS,0,u[0]*u[1]-1);
        int x=logical%u[0],y=clamp(logical/u[0]+dy,first,last);
#endif
        uint p=rawPixel(x,y);cachedPixels[at]=p;cachedLuma[at]=rawLuma(p);
#if GX_CACHE_CHROMA
        precise float rr=float((p>>16)&255u)-cachedLuma[at],bb=float(p&255u)-cachedLuma[at];
        cachedRed[at]=rr;cachedBlue[at]=bb;
#endif
    }
    barrier();cacheReady=true;
#if GX_DIFF_CACHE
    fillDifferences(first,last);
#endif
}

int halfSize(int a){return a/2+(a&1);}
int roundFloat(float value){
    int whole=int(value);
    // Exact Java Math.round ties, without rounding value+0.5 prematurely.
    precise float fraction=value-float(whole);
    return whole+(fraction>=0.5?1:fraction< -0.5?-1:0);
}
int byteValue(float value){return clamp(roundFloat(value),0,255);}
float square(float value){precise float result=value*value;return result;}
uint pixel(int x,int y){
    x=clamp(x,0,u[0]-1);y=clamp(y,0,u[1]-1);
    int at=cacheReady?cacheAt(x,y):-1;
    return at>=0?cachedPixels[at]:rawPixel(x,y);
}
float luma(uint p){
    return rawLuma(p);
}
vec3 color(int x,int y){
    return cacheColor(x,y);
}
float sampleDistance(int ax,int ay,int bx,int by,vec3 ca,vec3 cb){
#if GX_DIFF_CACHE
    // The original observation can clamp each endpoint independently. Reuse
    // only if the resulting displacement is still an original candidate;
    // otherwise compute that exact clamped pair directly.
    ax=clamp(ax,0,u[0]-1);bx=clamp(bx,0,u[0]-1);
    ay=clamp(ay,0,u[1]-1);by=clamp(by,0,u[1]-1);
    int dx=bx-ax,dy=by-ay;
    if(dy<0||(dy==0&&dx<0)){int tx=ax,ty=ay;ax=bx;ay=by;bx=tx;by=ty;dx=-dx;dy=-dy;}
    int offset=-1;
    if(STRONG_MODE==1){
        if(dy==0&&(dx==3||dx==6))offset=dx/3-1;
        else if((dy==3||dy==6)&&dx>=-6&&dx<=6&&dx%3==0)offset=2+(dy/3-1)*5+(dx+6)/3;
    }else{
        if(dy==0&&dx==4)offset=0;
        else if(dy==4&&(dx==-4||dx==0||dx==4))offset=1+(dx+4)/4;
    }
    int col=ax-tileX+DIFF_RADIUS,row=ay-tileY+DIFF_RADIUS;
    if(offset>=0&&col>=0&&col<DIFF_PITCH&&row>=0&&row<DIFF_ROWS)
        return cachedDistance[offset*DIFF_PLANE+row*DIFF_PITCH+col];
#endif
