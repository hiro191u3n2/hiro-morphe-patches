<?xml version="1.0" encoding="utf-8"?>
<!-- Authored test-only button group. synthetic_reverse_search is not an asserted app resource ID. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Button
        android:id="@+id/result_now_condition"
        android:tag="synthetic_now_search_marker"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:visibility="visible"
        android:enabled="true"
        android:clickable="true"
        android:focusable="true"
        android:alpha="1"
        android:text="@string/result_research_current_time" />
    <Button
        android:id="@+id/synthetic_reverse_search"
        android:tag="synthetic_reverse_search_marker"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:padding="11dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:visibility="visible"
        android:enabled="true"
        android:clickable="true"
        android:longClickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:alpha="1"
        android:importantForAccessibility="auto"
        android:text="@string/synthetic_reverse_search" />
    <Button
        android:id="@+id/result_back_condition"
        android:tag="synthetic_change_search_marker"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:visibility="visible"
        android:enabled="true"
        android:clickable="true"
        android:focusable="true"
        android:alpha="1"
        android:text="@string/result_list_change_condition" />
</merge>
