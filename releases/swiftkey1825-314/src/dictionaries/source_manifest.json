  "policy": {
    "preserve_baseline": true,
    "existing_candidate_order_first": true,
    "dedup": "runtime-normalized reading plus NFC-equivalent surface; preserve original surface spelling",
    "new_english_duplicates": "exclude",
    "reading": "2..32 normalized hiragana U+3041..U+3096 or long mark",
    "no_per_reading_cap": true,
    "jmdict": "respect re_restr and re_nokanji",
    "sudachi": "surface col4, reading col11, decode Unicode escapes, reject nonlexical POS space/symbols",
    "surface": "no empty/control/surrogate text; preserve meaningful variants",
    "new_surface_soft_hyphen": "remove only U+00AD before duplicate check; preserve baseline and all other format characters"
  }
